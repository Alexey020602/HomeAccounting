# Auto detect text files and perform LF normalization
* text=auto

# Force LF for all text files
* text eol=lf

# Explicitly declare text files you want to always be normalized and converted to native line endings on checkout
*.cs text eol=lf
*.csproj text eol=lf
*.sln text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.razor text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.jsx text eol=lf
*.config text eol=lf
*.txt text eol=lf
*.ps1 text eol=lf
*.sh text eol=lf
*.bat text eol=lf
*.cmd text eol=lf
*.env text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf
Dockerfile text eol=lf
*.dockerfile text eol=lf

# Denote all files that are truly binary and should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
