@page "/receipts"
@using BlazorConsolidated.Budgets.BudgetState
@using ClientServerContracts.Api.Budgets
@using ClientServerContracts.Budgets.GetReceipts
@using ClientServerShared.Results
@using MaybeResults
@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@attribute [Authorize]
@inherits BudgetPage
@inject IBudgetsApi BudgetsApi
@inject ISnackbar Snackbar

<PageTitle>Список чеков</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge">
    <MudCard>
        <MudCardHeader>
            <MudText Typo="Typo.h5" Color="Color.Primary">Добавленные чеки</MudText>
        </MudCardHeader>
        <MudCardContent>
            <MudDataGrid T="ReceiptDto"
                         ServerData="LoadReceiptsGrid"
                         pageSize="10"
                         Hover="true"
                         Striped="true"
                         Dense="true">
                <Columns>
                    <PropertyColumn Property="x => x.PurchaseDate" Title="Дата покупки" SortBy="x => x.PurchaseDate" Format="dd.MM.yyyy HH:mm"/>
                    <PropertyColumn Property="x => x.CreatedAt" Title="Добавлен" SortBy="x => x.CreatedAt" Format="dd.MM.yyyy HH:mm"/>
                    <PropertyColumn Property="x => x.PurchasePlace" Title="Место покупки" SortBy="x=>x.PurchasePlace"/>
                    <PropertyColumn Property="x => x.Sum" Title="Сумма" SortBy="x=>x.Sum"/>
                    <TemplateColumn Title="Статус">
                        <CellTemplate>
                            <ReceiptStatusComponent Status="context.Item.Status"/>
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
                <PagerContent>
                    <MudDataGridPager PageSizeSelector="false"/>
                </PagerContent>
            </MudDataGrid>
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    private static readonly HashSet<string> AllowedSortBy = ["Sum", "PurchaseDate", "CreatedAt", "CompletedAt", "PurchasePlace"];

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
    }

    private async Task<GridData<ReceiptDto>> LoadReceiptsGrid(GridState<ReceiptDto> state)
    {
        if (BudgetId == Guid.Empty)
        {
            return new GridData<ReceiptDto> { Items = [], TotalItems = 0 };
        }

        var query = new GetReceiptsQueryParameters
        {
            Skip = state.Page * state.PageSize,
            Take = state.PageSize
        };

        if (state.SortDefinitions.FirstOrDefault() is var (sortBy, descending, _, _, _))
        {
            // var first = state.SortDefinitions[0];
            if (!string.IsNullOrEmpty(sortBy) && AllowedSortBy.Contains(sortBy))
            {
                query.SortBy = sortBy;
                query.SortDescending = descending;
            }
        }

        var result = await BudgetsApi.GetReceipts(BudgetId, query).TryAsync();

        if (result is Some<GetReceiptsResponse> some)
        {
            var response = some.Value;
            return new GridData<ReceiptDto>
            {
                Items = response.Receipts,
                TotalItems = response.TotalCount
            };
        }

        Snackbar.Add("Не удалось загрузить список чеков", Severity.Error);
        return new GridData<ReceiptDto> { Items = [], TotalItems = 0 };
    }
}
