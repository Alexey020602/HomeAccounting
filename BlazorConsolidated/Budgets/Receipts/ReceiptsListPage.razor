@page "/receipts"
@using System.Globalization
@using BlazorConsolidated.Budgets.BudgetState
@using BlazorConsolidated.Common
@using ClientServerContracts.Api.Budgets
@using ClientServerContracts.Budgets.GetReceipts
@using ClientServerShared.Results
@using MaybeResults
@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@attribute [Authorize]
@inherits BudgetPage
@inject IBudgetsApi BudgetsApi
@inject ISnackbar Snackbar

<PageTitle>Список чеков</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge">
    <MudCard>
        <MudCardHeader>
            <MudText Typo="Typo.h5" Color="Color.Primary">Добавленные чеки</MudText>
        </MudCardHeader>
        <MudCardContent>
            <MudDataGrid T="Receipt"
                         ServerData="LoadReceiptsGrid"
                         pageSize="10"
                         Filterable="true"
                         Hover="true"
                         Striped="true"
                         Dense="true">
                <Columns>
                    <PropertyColumn Property="x => x.PurchaseDate" Title="Дата покупки" SortBy="x => x.PurchaseDate"
                                    Format="dd.MM.yyyy HH:mm"/>
                    <PropertyColumn Property="x => x.CreatedAt" Title="Добавлен" SortBy="x => x.CreatedAt"
                                    Format="dd.MM.yyyy HH:mm"/>
                    <PropertyColumn Property="x => x.PurchasePlace" Title="Место покупки" SortBy="x=>x.PurchasePlace"/>
                    <PropertyColumn Property="x => x.Sum" Title="Сумма" SortBy="x=>x.Sum" Format="F2"
                                    Culture="CultureInfo.InstalledUICulture"/>
                    <TemplateColumn Title="Статус">
                        <CellTemplate>
                            <ReceiptStatusComponent Status="context.Item.Status"/>
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
                <PagerContent>
                    <MudDataGridPager PageSizeSelector="false"/>
                </PagerContent>
            </MudDataGrid>
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    private static readonly HashSet<string> AllowedSortBy = ["Sum", "PurchaseDate", "CreatedAt", "CompletedAt", "PurchasePlace"];

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
    }

    private async Task<GridData<Receipt>> LoadReceiptsGrid(GridState<Receipt> state)
    {
        if (BudgetId == Guid.Empty)
        {
            return new GridData<Receipt> { Items = [], TotalItems = 0 };
        }

        var query = new GetReceiptsQueryParameters
        {
            Skip = state.Page * state.PageSize,
            Take = state.PageSize
        };

        query.Filter = state.FilterQuery;
        query.Sorting = state.SortingQuery;

        var result = await BudgetsApi.GetReceipts(BudgetId, query).TryAsync();

        if (result is Some<GetReceiptsResponse> some)
        {
            var response = some.Value;
            return new GridData<Receipt>
            {
                Items = response.Receipts.Select(r => new Receipt(r)),
                TotalItems = response.TotalCount
            };
        }

        Snackbar.Add("Не удалось загрузить список чеков", Severity.Error);
        return new GridData<Receipt> { Items = [], TotalItems = 0 };
    }

    private sealed record Receipt(Guid Id, decimal Sum, DateTime PurchaseDate, DateTime CreatedAt, string PurchasePlace, ReceiptStatus Status)
    {
        public Receipt(ReceiptDto dto) : this(dto.Id, dto.Sum / 100.0m, dto.PurchaseDate.DateTime, dto.CreatedAt.DateTime, dto.PurchasePlace, dto.Status)
        {
        }
    }

}
