@page "/categories/{categoryId:int?}"
@* @page "/categories/{*CategoryPath}" *@
@using System.IO
@using BlazorConsolidated.Common.Components
@using BlazorConsolidated.Common.Layouts
@using ClientServerContracts.Api.Categories
@using ClientServerContracts.Categories.GetCategories
@using ClientServerShared.Results
@using MaybeResults
@using Microsoft.JSInterop
@layout AuthLayout
@inject ICategoriesApi CategoriesApi
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager

<PageTitle>Категории</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium">
    @if (CategoryId is null)
    {
        <MudStack Row="true" Class="mb-4" Justify="Justify.FlexEnd">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Download"
                       Disabled="@_csvDownloading"
                       OnClick="DownloadCategoriesCsvAsync">
                Скачать CSV
            </MudButton>
        </MudStack>
    }
    <CategoriesComponent CategoriesResult="CategoriesResult"/>
</MudContainer>

@code {
    [Parameter]
    public int? CategoryId { get; set; }
    private IMaybe<CategoriesResponse>? CategoriesResult { get; set; }
    private bool _csvDownloading;

    private async Task DownloadCategoriesCsvAsync()
    {
        if (_csvDownloading) return;
        _csvDownloading = true;
        try
        {
            await using var stream = await CategoriesApi.GetCategoriesCsv();
            using var memory = new MemoryStream();
            await stream.CopyToAsync(memory);
            var base64 = Convert.ToBase64String(memory.ToArray());
            await JSRuntime.InvokeAsync<object>("saveFileAs", "categories.csv", "text/csv", base64);
        }
        finally
        {
            _csvDownloading = false;
            StateHasChanged();
        }
    }

