@using BlazorConsolidated.Common
@inherits LayoutComponentBase
@layout BaseLayout

<AppBar>
    <AfterTitleContent>
        <MudStack Row="true" Justify="Justify.FlexEnd" AlignItems="AlignItems.Center" Class="ms-auto" Spacing="2">
            <MudButton Variant="Variant.Text" Color="Color.Inherit" Href="/">Главная</MudButton>
        </MudStack>
    </AfterTitleContent>
</AppBar>

<MudMainContent>
    <MudContainer MaxWidth="MaxWidth.Small" Class="py-6">
        @Body
    </MudContainer>
</MudMainContent>
