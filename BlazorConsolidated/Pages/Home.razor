@page "/"
@layout BlazorConsolidated.Common.Layouts.GuestLayout
@* @using Budgets.UI *@
@using BlazorConsolidated.Budgets
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@* @attribute [Authorize] *@

<BudgetsSelectionView >
    <BudgetSelected Context="budgetState">
        <MudCard>
            <MudCardHeader>
                <MudText Typo="Typo.h1">Добро пожаловать</MudText>
                <MudText Typo="Typo.h5">Вы работаете с бюджетом @budgetState.Name</MudText>
            </MudCardHeader>
            <MudCardContent>
                @List(MenuItem.AuthorizedUserMenu)
            </MudCardContent>
        </MudCard>
    </BudgetSelected>
    <BudgetNotSelected>
        Для работы с бюджетами необходимо выбрать бюджет
        <MudLink Href="/budgets">Бюджеты</MudLink>
    </BudgetNotSelected>
    <NotAuthorized>
        Для работы с бюджетами необходимо авторизоваться
        <MudLink Href="/login">К авторизации</MudLink>
        <MudCard>
            <MudCardHeader>
                
            </MudCardHeader>
            <MudCardContent>
                @List(MenuItem.PublicItems)
            </MudCardContent>
        </MudCard>
    </NotAuthorized>
</BudgetsSelectionView>

@code
{
    private RenderFragment List(IReadOnlyList<MenuItem> menuItems) => @<MudList T="MenuItem">
                                                                          @foreach (var menuItem in menuItems)
                                                                          {
                                                                              <MudListItem
                                                                                  Href="@menuItem.Href"
                                                                                  Text="@menuItem.Name"
                                                                                  SecondaryText="@menuItem.Description"
                                                                                  Icon="@menuItem.Icon"
                                                                                  Ripple="true"/>
                                                                          }
                                                                      </MudList>;
}
