@using Microsoft.AspNetCore.Components.Authorization
@using BlazorConsolidated.Components
@using BlazorConsolidated.Layouts
@using BlazorConsolidated.Common.Layouts
@inject NavigationManager NavigationManager
@* <CascadingAuthenticationState @rendermode="AssignedRenderMode"> *@
    <AppErrorBoundary>
        @* <ChildContent> *@
        <Router AppAssembly="@typeof(MainLayout).Assembly">
            <Found Context="routeData">
                <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(GuestLayout)">
                    <Authorizing>
                        Проверка авторизации
                    </Authorizing>
                    <NotAuthorized Context="AuthenticationState">
                        <RedirectToLoginComponent
                            ReturnUrl="@NavigationManager.GetCurrentPath()"></RedirectToLoginComponent>
                    </NotAuthorized>
                </AuthorizeRouteView>
                <FocusOnNavigate RouteData="@routeData" Selector="h1"/>
            </Found>
            <NotFound>
                <PageTitle>Not found</PageTitle>
                <LayoutView Layout="@typeof(GuestLayout)">
                    <p role="alert">Sorry, there's nothing at this address.</p>
                </LayoutView>
            </NotFound>
        </Router>
        @* </ChildContent> *@
    </AppErrorBoundary>
@* </CascadingAuthenticationState> *@
