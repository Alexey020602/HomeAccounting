@using System.ComponentModel.DataAnnotations
@using System.Linq.Expressions
@using global::Receipts.Contracts
@using SkiaSharp.Views.Blazor;
@using Microsoft.AspNetCore.Components.Forms
@using MudBlazor
@using Shared.Utils.BarCode

@inject IBarcodeService BarcodeService

<MudCard Elevation="5">
    <MudCardContent>
        <EditForm Model="@Model" OnValidSubmit="SendFileRequest">
            <DataAnnotationsValidator/>

            <MudGrid Spacing="3" Justify="Justify.FlexStart">
                <MudItem xs="12">
                    <MudInputLabel>Изображение чека *</MudInputLabel>
                    <MudFileUpload
                        T="IBrowserFile"
                        For="Model.FileValidation"
                        Accept="image/*"
                        Disabled="@Disabled"
                        @bind-Files="Model.SelectedFile">
                        <ActivatorContent>
                            <MudChip T="string" Variant="Variant.Filled" Color="Color.Primary" Text="Нажмите для выбора"/>
                        </ActivatorContent>
                        <SelectedTemplate Context="file">
                            @if (file is not null)
                            {
                                <MudChip
                                    Class="mt-2"
                                    Icon="@Icons.Material.Filled.Image"
                                    T="string"
                                    Text="@file.Name"
                                    OnClose="ClearFile"/>
                            }
                        </SelectedTemplate>
                    </MudFileUpload>
                </MudItem>
                <MudItem xs="12">
                    <MudStack Row="true" Justify="Justify.FlexEnd">
                        <MudButton
                            Disabled="@Disabled"
                            Variant="Variant.Filled"
                            Color="Color.Primary"
                            ButtonType="ButtonType.Submit">
                            Сохранить чек
                        </MudButton>
                        <MudButton
                            Variant="Variant.Outlined"
                            Color="Color.Secondary"
                            Disabled="@(Disabled || Model.SelectedFile == null)"
                            OnClick="Cancel">
                            Отмена
                        </MudButton>
                    </MudStack>
                </MudItem>
            </MudGrid>
        </EditForm>
    </MudCardContent>
</MudCard>

@code {
    [Parameter] public EventCallback<Stream> OnSubmitWithStream { get; set; }
    [Parameter] public EventCallback<CheckRequest> OnSubmitWithRequest { get; set; }
    [Parameter] public bool Disabled { get; set; }
    private const int MaxFileSize = 10 * 1024 * 1024;

    private FormModel Model { get; set; } = new();
    private async Task SendFileRequest()
    {
        await using var stream = Model.GetReadStream();
        if (OnSubmitWithRequest is { HasDelegate: true })
        {
            var barcode = await BarcodeService.ReadBarcodeAsync(stream);
            var request = new CheckRequest(
                barcode,
                TimeZoneInfo.Local.Id
            );
            await OnSubmitWithRequest.InvokeAsync(request);
        }
        else
        {
            await OnSubmitWithStream.InvokeAsync(stream);
        }
    }

    private Task OnChange(InputFileChangeEventArgs args)
    {
        Model.SelectedFile = args.File;

        return Task.CompletedTask;
    }

    private void Cancel()
    {
        Model = new();
    }

    private void ClearFile()
    {
        Model.SelectedFile = null;
    }

    private sealed class FormModel
    {
        [Required(ErrorMessage = "Выберите файл с чеком")]
        public IBrowserFile? SelectedFile { get; set; }

        public Stream GetReadStream() => SelectedFile?.OpenReadStream(maxAllowedSize: MaxFileSize) ?? throw new Exception("Не выбран файл");

        public Expression<Func<IBrowserFile?>> FileValidation => () => SelectedFile;
    }
}